{
  "name": "kv-digital-cinema-backend",
  "version": "1.0.0",
  "description": "KV Digital Cinema - Full Stack Movie Streaming Backend API",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "npx prisma generate && npx prisma db push && node server.js",
    "build": "npx prisma generate && npx prisma db push && node prisma/seed.js",
    "db:init": "npx prisma generate && npx prisma db push && node prisma/seed.js",
    "dev": "nodemon -e js,mjs,cjs,json,env server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:migrate": "npx prisma migrate dev",
    "db:seed": "node prisma/seed.js"
  },

  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@supabase/supabase-js": "^2.112.4",
    "axios": "^1.6.7",
    "bakong-khqr": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.10",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2"
  }
}
