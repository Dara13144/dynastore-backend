# ==============================================================================
# DYNA STORE - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================

# Server Configuration
PORT=5050
NODE_ENV=production
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="replace_with_a_secure_jwt_secret_key_at_least_32_characters"
JWT_REFRESH_SECRET="replace_with_a_secure_jwt_refresh_secret_key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Frontend Application Origin
FRONTEND_URL="http://localhost:5173"

# ==============================================================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ==============================================================================
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ==============================================================================
# SUPABASE CLOUD DATABASE & STORAGE CONFIGURATION
# ==============================================================================
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="dynastore-media"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_DATABASE_URL="postgresql://postgres:PASSWORD@db.your-project-id.supabase.co:5432/postgres"

# ==============================================================================
# CUTLUY PAYMENT GATEWAY CONFIGURATION
# ==============================================================================
CUTLUY_API_URL="https://cutluy.com/v1/payments"
CUTLUY_API_KEY="YOUR_CUTLUY_API_KEY"
CUTLUY_WEBHOOK_SECRET="YOUR_CUTLUY_WEBHOOK_SECRET"
CUTLUY_MERCHANT_NAME="DYNA STORE"

# ==============================================================================
# BAKONG OPEN API CONFIGURATION
# ==============================================================================
BAKONG_API_URL="https://api-bakong.nbc.gov.kh/v1"
BAKONG_API_TOKEN="YOUR_BAKONG_API_TOKEN"
BAKONG_ACCOUNT_ID="your_account@bkrt"
BAKONG_MERCHANT_NAME="DYNA STORE"
BAKONG_MERCHANT_CITY="Phnom Penh"

# ==============================================================================
# KHQR.CC PAYMENT GATEWAY CONFIGURATION
# ==============================================================================
KHQR_CC_PROFILE_ID="YOUR_PROFILE_ID"
KHQR_CC_SECRET_KEY="YOUR_SECRET_KEY"
KHQR_CC_ACCOUNT_ID="your_account@bkrt"
KHQR_CC_API_URL="https://khqr.cc/api/YOUR_PROFILE_ID/payment-gateway/v1/payments/qr-api"
KHQR_CC_CHECKOUT_URL="https://khqr.cc/api/payment/request"
KHQR_MERCHANT_NAME="DYNA STORE"
KHQR_MERCHANT_CITY="Phnom Penh"
KHQR_CURRENCY="USD"
